    // Puan Hesaplama & Eleştirmen Merceği
    function computeVerdict(movie, lens = 'balanced') {
      const imdb100 = movie.imdb ? movie.imdb * 10 : null;
      const critic100 = movie.rt !== null && movie.rt !== undefined
        ? movie.rt
        : (movie.metascore !== null && movie.metascore !== undefined ? movie.metascore : null);

      let score = 75;
      if (imdb100 !== null && critic100 !== null) {
        if (lens === 'critic') score = Math.round(critic100 * 0.72 + imdb100 * 0.28);
        else if (lens === 'audience') score = Math.round(imdb100 * 0.75 + critic100 * 0.25);
        else score = Math.round(imdb100 * 0.52 + critic100 * 0.48);
      } else if (imdb100 !== null) {
        score = Math.round(imdb100);
      } else if (critic100 !== null) {
        score = Math.round(critic100);
      }

      score = Math.max(10, Math.min(99, score));
      let label = 'Ortalama';
      let colorClass = 'text-amber-400';
      if (score >= 86) { label = 'Kaçırılmamalı'; colorClass = 'text-emerald-400'; }
      else if (score >= 76) { label = 'İzlemeye Değer'; colorClass = 'text-emerald-300'; }
      else if (score >= 65) { label = 'Şans Verilebilir'; colorClass = 'text-amber-300'; }
      else { label = 'Beklentiyi Düşük Tut'; colorClass = 'text-rose-400'; }

      return { score, label, colorClass };
    }

    function buildTurkishCriticNote(movie, verdict) {
      if (movie.criticNote) return movie.criticNote;
      const genreText = movie.genres.length ? movie.genres.slice(0, 2).join(' ve ').toLowerCase() : 'sinema';
      const scoreParts = [];
      if (movie.imdb) scoreParts.push(`IMDb'de ${movie.imdb.toFixed(1)}`);
      if (movie.rt !== null && movie.rt !== undefined) scoreParts.push(`Rotten Tomatoes'ta %${movie.rt}`);
      else if (movie.metascore) scoreParts.push(`Metacritic'te ${movie.metascore}/100`);

      const leadText = scoreParts.length ? `${scoreParts.join(' ve ')} puanlarıyla öne çıkan yapım, ` : '';
      if (verdict.score >= 85) {
        return `${leadText}${genreText} türünde hem eleştirmenlerden hem izleyicilerden tam not alan güçlü bir film. ${movie.director !== '—' ? movie.director + ' imzasını taşıyan ' : ''}bu yapımı izleme listene gönül rahatlığıyla ekleyebilirsin.`;
      }
      if (verdict.score >= 75) {
        return `${leadText}${genreText} sevenler için tatmin edici, dengeli ve sürükleyici bir tercih. Akşam keyifli ve nitelikli bir film arıyorsan beklentini karşılayacaktır.`;
      }
      if (verdict.score >= 65) {
        return `${leadText}türün meraklılarına hitap eden, kusurlarına rağmen izlenebilir bir yapım. Özellikle ${movie.cast !== '—' ? 'oyuncu kadrosunu' : 'bu türü'} seviyorsan şans verebilirsin.`;
      }
      return `${leadText}eleştirmenleri ve izleyicileri ikiye bölen bir yapım. Sadece konusuna ya da kadrosuna özel ilgin varsa değerlendirmeni öneririm.`;
    }

    // Benzer film/dizi havuzundan 3'lü grup zenginleştir (OMDb IMDb + RT puanları + Türkçe başlık)
    async function hydrateSimilarBatch(rawItems, mediaType = 'movie') {
      const isTv = mediaType === 'tv';
      const detailPrefix = isTv ? '/tv' : '/movie';
      return Promise.all(rawItems.map(async (m) => {
        const rawTitle = isTv ? (m.name || m.original_name) : (m.title || m.original_title);
        const rawOrig = isTv ? (m.original_name || m.name) : (m.original_title || m.title);
        const sYear = (isTv ? (m.first_air_date || '') : (m.release_date || '')).slice(0, 4);
        let enTitle = '';
        if (hasNonLatinScript(rawTitle)) {
          const enInfo = await tmdbFetch(`${detailPrefix}/${m.id}`, { language: 'en-US' }).catch(() => null);
          enTitle = isTv ? (enInfo?.name || '') : (enInfo?.title || '');
        }
        const omdbQueryTitle = enTitle || (!hasNonLatinScript(rawOrig) ? rawOrig : rawTitle);
        const sOmdbRaw = await omdbFetch({ title: omdbQueryTitle, year: sYear, mediaType });
        const sOmdb = extractOmdbRatings(sOmdbRaw);
        const displayTitle = await resolveTurkishTitle({
          trTitle: rawTitle,
          enTitle: enTitle || (sOmdbRaw?.Title || ''),
          originalTitle: rawOrig,
          originalLang: m.original_language
        });
        const sGenres = (m.genre_ids || []).map(id => GENRE_TR[id]).filter(Boolean).slice(0, 2).join(' • ');
        const reasonTag = m._reason ? `${m._reason}${sGenres ? ' • ' + sGenres : ''}` : (sGenres || 'Aynı temada yüksek puanlı');
        return {
          tmdbId: m.id,
          mediaType,
          title: displayTitle,
          year: sYear,
          imdb: sOmdb.imdb || (m.vote_average ? Number(m.vote_average.toFixed(1)) : null),
          rt: sOmdb.rt,
          posterUrl: m.poster_path ? `https://image.tmdb.org/t/p/w300${m.poster_path}` : (sOmdb.poster || ''),
          note: reasonTag
        };
      }));
    }

    // TMDb Film veya Dizi Detayını Tam Paket Olarak Çek
    async function fetchFullMovieByTmdbId(tmdbId, mediaType = activeMediaType) {
      const isTv = mediaType === 'tv';
      const basePath = isTv ? `/tv/${tmdbId}` : `/movie/${tmdbId}`;
      const [trDetail, enDetail] = await Promise.all([
        tmdbFetch(basePath, {
          language: 'tr-TR',
          append_to_response: 'credits,external_ids,recommendations,similar,watch/providers,keywords,videos'
        }),
        tmdbFetch(basePath, {
          language: 'en-US',
          append_to_response: 'videos'
        }).catch(() => null)
      ]);

      const rawTrTitle = isTv ? trDetail.name : trDetail.title;
      const originalTitle = isTv
        ? (trDetail.original_name || enDetail?.name || trDetail.name)
        : (trDetail.original_title || enDetail?.title || trDetail.title);
      const enTitle = isTv ? (enDetail?.name || '') : (enDetail?.title || '');
      const imdbId = trDetail.imdb_id || trDetail.external_ids?.imdb_id || enDetail?.imdb_id || '';
      const year = (isTv
        ? (trDetail.first_air_date || enDetail?.first_air_date || '')
        : (trDetail.release_date || enDetail?.release_date || '')
      ).slice(0, 4);

      const omdbRaw = await omdbFetch({ imdbId, title: enTitle || originalTitle, year, mediaType });
      const omdb = extractOmdbRatings(omdbRaw);

      const resolvedTurkishTitle = await resolveTurkishTitle({
        trTitle: rawTrTitle,
        enTitle: enTitle || (omdbRaw?.Title || ''),
        originalTitle,
        originalLang: trDetail.original_language
      });

      const crew = trDetail.credits?.crew || [];
      let directorItems = [];
      if (isTv && Array.isArray(trDetail.created_by) && trDetail.created_by.length) {
        directorItems = trDetail.created_by.slice(0, 2).map(c => ({ id: c.id || null, name: c.name }));
      } else {
        directorItems = crew
          .filter(c => (c.job === 'Director' || (isTv && c.job === 'Executive Producer')) && c.name)
          .slice(0, 2)
          .map(c => ({ id: c.id || null, name: c.name }));
      }
      const director = directorItems.length ? directorItems.map(d => d.name).join(', ') : (omdb.director || '—');

      const castItems = (trDetail.credits?.cast || [])
        .filter(c => c && c.name)
        .slice(0, 4)
        .map(c => ({ id: c.id || null, name: c.name }));
      const cast = castItems.length ? castItems.map(c => c.name).join(', ') : (omdb.actors || '—');

      const posterUrl = trDetail.poster_path
        ? `https://image.tmdb.org/t/p/w500${trDetail.poster_path}`
        : (enDetail?.poster_path ? `https://image.tmdb.org/t/p/w500${enDetail.poster_path}` : omdb.poster);
      const backdropUrl = trDetail.backdrop_path
        ? `https://image.tmdb.org/t/p/w1280${trDetail.backdrop_path}`
        : (enDetail?.backdrop_path ? `https://image.tmdb.org/t/p/w1280${enDetail.backdrop_path}` : '');

      const watchProviders = extractTrWatchProviders(trDetail['watch/providers'], resolvedTurkishTitle || originalTitle);

      // En iyi YouTube fragmanını seç
      const pickBestYoutubeTrailer = (trVideos, enVideos) => {
        const filterYt = (list) => (list || []).filter(v => v && v.site === 'YouTube' && v.key && (v.type === 'Trailer' || v.type === 'Teaser'));
        const trList = filterYt(trVideos);
        const enList = filterYt(enVideos);
        const pickFrom = (list) =>
          list.find(v => v.type === 'Trailer' && v.official) ||
          list.find(v => v.type === 'Trailer') ||
          list[0] || null;
        const bestTr = pickFrom(trList);
        if (bestTr) return { key: bestTr.key, name: bestTr.name || 'Türkçe Fragman', lang: 'Türkçe Fragman' };
        const bestEn = pickFrom(enList);
        if (bestEn) return { key: bestEn.key, name: bestEn.name || 'Resmî Fragman', lang: 'Orijinal Fragman' };
        return null;
      };
      const trailer = pickBestYoutubeTrailer(trDetail.videos?.results, enDetail?.videos?.results);

      let plot = (trDetail.overview || '').trim();
      if (!plot && enDetail?.overview) {
        plot = await translateToTurkish(enDetail.overview);
      }
      if (!plot) {
        const gNames = (trDetail.genres || []).map(g => g.name).slice(0, 2).join(', ');
        plot = `${resolvedTurkishTitle}, ${year || 'yakın dönem'} yapımı${gNames ? ` bir ${gNames.toLowerCase()} ${isTv ? 'dizisi' : 'filmi'}` : ` dikkat çekici bir ${isTv ? 'dizi' : 'sinema yapımı'}`}.`;
      }

      const genres = (trDetail.genres || []).map(g => GENRE_TR[g.id] || g.name).filter(Boolean);
      const imdbScore = omdb.imdb || (trDetail.vote_average ? Number(trDetail.vote_average.toFixed(1)) : null);

      let runtimeText = '';
      if (isTv) {
        const parts = [];
        if (trDetail.number_of_seasons) parts.push(`${trDetail.number_of_seasons} Sezon`);
        if (trDetail.number_of_episodes) parts.push(`${trDetail.number_of_episodes} Bölüm`);
        runtimeText = parts.join(' • ');
      } else if (trDetail.runtime) {
        runtimeText = `${trDetail.runtime} dk`;
      }

      // Genişletilmiş Konu + Güncellik + İzleyici Örtüşmesi Benzer Motoru (Film + Dizi)
      const movieGenreIds = (trDetail.genres || []).map(g => g.id);
      const kwObjs = (isTv ? (trDetail.keywords?.results || []) : (trDetail.keywords?.keywords || [])).slice(0, 6);
      const kwIdsStr = kwObjs.map(k => String(k.id)).join('|');
      const primaryGenresStr = movieGenreIds.slice(0, 2).join('|');
      const dateField = isTv ? 'first_air_date.gte' : 'primary_release_date.gte';

      const [recPage2Res, kwRecentRes, kwBroadRes] = await Promise.all([
        tmdbFetch(`${basePath}/recommendations`, { language: 'tr-TR', page: 2 }).catch(() => ({ results: [] })),
        kwIdsStr
          ? fetchMultiPageDiscover({
              language: 'tr-TR',
              sort_by: 'vote_average.desc',
              include_adult: 'false',
              with_keywords: kwIdsStr,
              ...(primaryGenresStr ? { with_genres: primaryGenresStr } : {}),
              [dateField]: '2014-01-01',
              'vote_average.gte': 6.9,
              'vote_count.gte': isTv ? 50 : 100,
              'vote_count.lte': 12000
            }, 2, mediaType).catch(() => [])
          : Promise.resolve([]),
        kwIdsStr
          ? tmdbFetch(isTv ? '/discover/tv' : '/discover/movie', {
              language: 'tr-TR',
              sort_by: 'popularity.desc',
              include_adult: 'false',
              with_keywords: kwIdsStr,
              [dateField]: '2012-01-01',
              'vote_average.gte': 6.8,
              'vote_count.gte': isTv ? 40 : 80,
              page: 1
            }).then(r => r.results || []).catch(() => [])
          : Promise.resolve([])
      ]);

      const recPool = [...(trDetail.recommendations?.results || []), ...(recPage2Res.results || [])];
      const simPool = trDetail.similar?.results || [];
      const kwPool = [...kwRecentRes, ...kwBroadRes];

      const recIdSet = new Set(recPool.map(m => m.id));
      const kwIdSet = new Set(kwPool.map(m => m.id));
      const scoredSim = new Map();

      for (const item of [...kwPool, ...recPool, ...simPool]) {
        if (!item || item.id === trDetail.id) continue;
        if ((item.vote_average || 0) < 6.7 || (item.vote_count || 0) < (isTv ? 40 : 70)) continue;
        if (scoredSim.has(item.id)) continue;

        const dateStr = isTv ? (item.first_air_date || '') : (item.release_date || '');
        const mYear = parseInt(dateStr.slice(0, 4), 10) || 2000;
        const sharedGenres = (item.genre_ids || []).filter(id => movieGenreIds.includes(id)).length;
        const inKw = kwIdSet.has(item.id);
        const inRec = recIdSet.has(item.id);
        const votes = item.vote_count || 0;

        let score = 0;
        if (inKw && inRec) score += 18;
        else if (inKw) score += 10;
        else if (inRec) score += 7;
        else score += 2;

        score += sharedGenres * 2.5;
        if (mYear >= 2019) score += 5;
        else if (mYear >= 2015) score += 3.5;
        else if (mYear >= 2010) score += 1.5;
        if (votes >= 120 && votes <= 7000) score += 3;
        else if (votes > 16000) score -= 3.5;
        score += ((item.vote_average || 7) - 6.7) * 2.2;

        const reason = (inKw && inRec)
          ? 'Aynı konu & yüksek uyum'
          : (inKw ? 'Aynı tema' : (mYear >= 2018 ? 'Güncel benzer öneri' : 'Bunu izleyenlerin seçimi'));

        scoredSim.set(item.id, { movie: { ...item, _reason: reason }, score });
      }

      const similarPoolRanked = Array.from(scoredSim.values())
        .sort((a, b) => b.score - a.score)
        .map(x => x.movie);

      const topSimilarRaw = similarPoolRanked.slice(0, 3);
      const similar = await hydrateSimilarBatch(topSimilarRaw, mediaType);

      return {
        id: `tmdb-${mediaType}-${trDetail.id}`,
        tmdbId: trDetail.id,
        mediaType,
        imdbId,
        title: resolvedTurkishTitle,
        originalTitle: (enTitle && hasNonLatinScript(originalTitle)) ? `${enTitle} (${originalTitle})` : originalTitle,
        year: year || '—',
        runtime: runtimeText,
        director,
        directorItems,
        cast,
        castItems,
        genres,
        imdb: imdbScore,
        imdbVotes: omdb.imdbVotes,
        imdbFromOmdb: Boolean(omdb.imdb),
        rt: omdb.rt,
        metascore: omdb.metascore,
        posterUrl,
        backdropUrl,
        watchProviders,
        trailer,
        plot,
        criticNote: '',
        sourceLabel: isTv ? 'Canlı Dizi Verisi (TMDb + OMDb)' : 'Canlı Veri (TMDb + OMDb)',
        similar,
        similarPool: similarPoolRanked,
        similarOffset: 3
      };
    }

    // Film veya Dizi Arama
    async function searchMovie(query, forcedMediaType = activeMediaType) {
      const clean = query.trim();
      if (!clean) return;
      const isTv = forcedMediaType === 'tv';
      const searchEndpoint = isTv ? '/search/tv' : '/search/movie';
      const noun = isTv ? 'dizi' : 'film';
      $('moodBanner').classList.add('hidden');
      showStatus(`"${clean}" ${noun} için canlı veriler, afiş, puanlar ve Türkiye izleme platformları getiriliyor...`, 'info');

      try {
        const searchRes = await tmdbFetch(searchEndpoint, { query: clean, language: 'tr-TR', include_adult: 'false' });
        let results = searchRes.results || [];
        if (!results.length) {
          const enSearch = await tmdbFetch(searchEndpoint, { query: clean, language: 'en-US', include_adult: 'false' });
          results = enSearch.results || [];
        }
        if (!results.length) {
          if (!isTv) {
            const fb = FALLBACK_MOVIES.find(m =>
              m.title.toLowerCase().includes(clean.toLowerCase()) ||
              m.originalTitle.toLowerCase().includes(clean.toLowerCase())
            );
            if (fb) {
              renderMovie({ ...fb, mediaType: 'movie' });
              hideStatus();
              return;
            }
          }
          showStatus(`"${clean}" adıyla eşleşen bir ${noun} bulunamadı. Orijinal veya Türkçe adını kontrol edip tekrar deneyebilirsin.`, 'error');
          return;
        }

        const best = results.find(r => (r.vote_count || 0) >= 25) || results[0];
        const fullMovie = await fetchFullMovieByTmdbId(best.id, forcedMediaType);
        renderMovie(fullMovie);
        hideStatus();
      } catch (err) {
        const fb = FALLBACK_MOVIES.find(m =>
          m.title.toLowerCase().includes(clean.toLowerCase()) ||
          m.originalTitle.toLowerCase().includes(clean.toLowerCase())
        );
        if (fb) {
          renderMovie({ ...fb, sourceLabel: 'Çevrimdışı Yedek Veri' });
          showStatus('Canlı bağlantıda geçici bir sorun oluştu; yedek kayıt gösteriliyor.', 'error');
        } else {
          showStatus(`Veri çekilirken bir hata oluştu: ${err.message}`, 'error');
        }
      }
    }

    // Tek Kişilik Serbest Konu / Ruh Hali Keşfi (Çok Sayfalı + Özgül Anahtar Kelime + Platform Filtreli)
    async function recommendByMood(moodText) {
      const raw = (moodText || '').trim();
      if (!raw) {
        showStatus('Lütfen bugünkü ruh halini veya izlemek istediğin konuyu yaz ya da etiketlerden birini seç.', 'error');
        return;
      }
      activeRecMode = 'single';
      lastSingleQuery = raw;

      const hiddenGemsOnly = $('hiddenGemToggle').checked;
      const platformLabels = getSelectedPlatformLabels();
      const platformSuffix = platformLabels.length ? ` (${platformLabels.join(', ')})` : '';

      showStatus(`"${raw}" için${platformSuffix} geniş film havuzu taranıyor...`, 'info');

      try {
        const mediaType = activeMediaType;
        const isTv = mediaType === 'tv';
        const dateField = isTv ? 'first_air_date.gte' : 'primary_release_date.gte';
        const pref = await resolveFreeTopic(raw);
        const mappedGenres = mapGenresForMediaType(pref.genreIds, mediaType);
        const kwParam = pref.keywordIds.length ? pref.keywordIds.join('|') : '';
        const genreParam = mappedGenres.length ? mappedGenres.join('|') : '';
        const hasOrigin = pref.countries.length > 0 || pref.languages.length > 0;
        const minVotesStrict = hasOrigin ? (isTv ? 25 : 45) : (hiddenGemsOnly ? (isTv ? 60 : 120) : (isTv ? 150 : 280));

        const withAllFilters = (obj) => applyOriginParams(applyPlatformParams(obj, mediaType), pref.countries, pref.languages);
        const queries = [];

        // 1) Öncelik: Gerçek konu anahtar kelimeleri (+ varsa ülke/sinema filtresi)
        if (kwParam) {
          queries.push(withAllFilters({
            language: 'tr-TR',
            sort_by: 'vote_average.desc',
            include_adult: 'false',
            'vote_average.gte': 7.0,
            'vote_count.gte': hasOrigin ? 30 : (hiddenGemsOnly ? 80 : 150),
            ...(hiddenGemsOnly ? { 'vote_count.lte': 6000 } : {}),
            with_keywords: kwParam,
            ...(genreParam ? { with_genres: genreParam } : {})
          }));
          queries.push(withAllFilters({
            language: 'tr-TR',
            sort_by: 'popularity.desc',
            include_adult: 'false',
            'vote_average.gte': 6.6,
            'vote_count.gte': hasOrigin ? 25 : 50,
            with_keywords: kwParam
          }));
        }
        // 2) Tür bazlı (+ varsa ülke/sinema filtresi)
        if (genreParam) {
          queries.push(withAllFilters({
            language: 'tr-TR',
            sort_by: 'vote_average.desc',
            include_adult: 'false',
            'vote_average.gte': 7.2,
            'vote_count.gte': minVotesStrict,
            ...(hiddenGemsOnly ? { 'vote_count.lte': 5000, [dateField]: '2010-01-01' } : {}),
            with_genres: genreParam
          }));
          queries.push(withAllFilters({
            language: 'tr-TR',
            sort_by: 'popularity.desc',
            include_adult: 'false',
            'vote_average.gte': 6.8,
            'vote_count.gte': hasOrigin ? 25 : 60,
            with_genres: genreParam
          }));
        }
        // 3) Sadece ülke/sinema girildiyse (örn: "kore filmleri", "fransız") veya hiçbir filtre yoksa
        if (!queries.length || (hasOrigin && !kwParam && !genreParam)) {
          queries.push(withAllFilters({
            language: 'tr-TR',
            sort_by: 'vote_average.desc',
            include_adult: 'false',
            'vote_average.gte': 7.2,
            'vote_count.gte': hasOrigin ? 50 : 150,
            ...(hiddenGemsOnly ? { 'vote_count.lte': 6500, [dateField]: '2008-01-01' } : {})
          }));
          queries.push(withAllFilters({
            language: 'tr-TR',
            sort_by: 'popularity.desc',
            include_adult: 'false',
            'vote_average.gte': 6.8,
            'vote_count.gte': hasOrigin ? 30 : 80
          }));
        }

        const candidateMap = new Map();
        for (let i = 0; i < queries.length; i++) {
          const batch = await fetchMultiPageDiscover(queries[i], 3);
          for (const m of batch) {
            if (!candidateMap.has(m.id)) {
              candidateMap.set(m.id, { movie: m, priority: i === 0 && kwParam ? 2 : 1 });
            }
          }
          if (candidateMap.size >= 35) break;
        }

        let pool = Array.from(candidateMap.values())
          .sort((a, b) => (b.priority - a.priority) || ((b.movie.vote_average || 0) - (a.movie.vote_average || 0)))
          .map(x => x.movie);

        if (!pool.length) {
          showStatus(
            platformLabels.length
              ? `Seçili platformlarda (${platformLabels.join(', ')}) "${raw}" için uygun film bulunamadı. Platform filtresini genişletip tekrar deneyebilirsin.`
              : `"${raw}" konusu için uygun film bulunamadı. Farklı bir kelime deneyebilirsin.`,
            'error'
          );
          return;
        }

        const watchedIds = getWatchedTmdbIdSet();
        let unseen = pool.filter(m => !seenMoodIds.has(m.id) && !watchedIds.has(m.id));
        if (!unseen.length) {
          seenMoodIds.clear();
          unseen = pool.filter(m => !watchedIds.has(m.id));
        }
        if (!unseen.length) {
          seenMoodIds.clear();
          unseen = pool;
        }

        const topSlice = unseen.slice(0, Math.min(unseen.length, 25));
        const picked = topSlice[Math.floor(Math.random() * topSlice.length)];
        seenMoodIds.add(picked.id);

        const fullMovie = await fetchFullMovieByTmdbId(picked.id, activeMediaType);
        renderMovie(fullMovie);

        $('moodBannerTitle').textContent = 'Öneri:';
        const extraTags = getExtraFilterLabels();
        $('moodBannerText').textContent = ` ${pref.displayLabel}${platformLabels.length ? ` • ${platformLabels.join(', ')}` : ''}${extraTags.length ? ` • ${extraTags.join(', ')}` : ''} (${pool.length} film taranarak seçildi)`;
        $('moodBanner').classList.remove('hidden');
        hideStatus();
      } catch (err) {
        const fallbackPick = FALLBACK_MOVIES[Math.floor(Math.random() * FALLBACK_MOVIES.length)];
        renderMovie({ ...fallbackPick, sourceLabel: 'Çevrimdışı Yedek Öneri' });
        $('moodBannerTitle').textContent = 'Öneri:';
        $('moodBannerText').textContent = ` ${raw} (Yedek Öneri)`;
        $('moodBanner').classList.remove('hidden');
        showStatus('Canlı keşif sırasında geçici bir sorun oluştu; yedek öneri gösterildi.', 'error');
      }
    }

    // 2 Kişilik Ortak Film Seç — Sınırsız Serbest Konu + Çok Sayfalı Geniş Havuz + Çift Eşleşme Puanlaması
    async function recommendJointMovie(text1, text2) {
      const q1 = (text1 || '').trim();
      const q2 = (text2 || '').trim();
      if (!q1 || !q2) {
        showStatus('Ortak film seçebilmem için lütfen hem 1. kişi hem 2. kişi kutusuna bir ruh hali veya konu yaz.', 'error');
        return;
      }

      activeRecMode = 'joint';
      lastJointQueries = { p1: q1, p2: q2 };

      const hiddenGemsOnly = $('hiddenGemToggle').checked;
      const platformLabels = getSelectedPlatformLabels();
      const platformSuffix = platformLabels.length ? ` (${platformLabels.join(', ')})` : '';

      showStatus(`"${q1}" ve "${q2}" için${platformSuffix} geniş film havuzunda ortak kesişim aranıyor...`, 'info');

      try {
        const [p1, p2] = await Promise.all([resolveFreeTopic(q1), resolveFreeTopic(q2)]);

        const mediaType = activeMediaType;
        const isTv = mediaType === 'tv';
        const p1Genres = mapGenresForMediaType(p1.genreIds, mediaType);
        const p2Genres = mapGenresForMediaType(p2.genreIds, mediaType);
        const kw1 = p1.keywordIds.join('|');
        const kw2 = p2.keywordIds.join('|');
        const g1 = p1Genres[0] || null;
        const g2 = p2Genres[0] || null;
        const jointCountries = Array.from(new Set([...p1.countries, ...p2.countries]));
        const jointLanguages = Array.from(new Set([...p1.languages, ...p2.languages]));
        const hasOrigin = jointCountries.length > 0 || jointLanguages.length > 0;

        const withJointFilters = (obj) => applyOriginParams(applyPlatformParams(obj, mediaType), jointCountries, jointLanguages);

        const baseQuality = {
          language: 'tr-TR',
          include_adult: 'false',
          'vote_average.gte': 6.7,
          'vote_count.gte': hasOrigin ? 30 : (hiddenGemsOnly ? 60 : 120),
          ...(hiddenGemsOnly ? { 'vote_count.lte': 8000 } : {})
        };

        // Paralel çok katmanlı sorgular: ülke/sinema + konu kesişimi + tür kesişimi
        const queryTasks = [];

        // A) En Keskin Kesişim: 1. Kişinin konusu + 2. Kişinin türü (ve tersi)
        if (kw1 && g2) {
          queryTasks.push({
            tag: 'both',
            promise: fetchMultiPageDiscover(withJointFilters({ ...baseQuality, sort_by: 'vote_average.desc', with_keywords: kw1, with_genres: String(g2) }), 3)
          });
        }
        if (kw2 && g1) {
          queryTasks.push({
            tag: 'both',
            promise: fetchMultiPageDiscover(withJointFilters({ ...baseQuality, sort_by: 'vote_average.desc', with_keywords: kw2, with_genres: String(g1) }), 3)
          });
        }
        // B) Her iki kişinin de özgül anahtar kelimesi varsa havuzlarını çekip kesiştir
        if (kw1 && kw2) {
          queryTasks.push({
            tag: 'p1_kw',
            promise: fetchMultiPageDiscover(withJointFilters({ ...baseQuality, sort_by: 'popularity.desc', with_keywords: kw1 }), 3)
          });
          queryTasks.push({
            tag: 'p2_kw',
            promise: fetchMultiPageDiscover(withJointFilters({ ...baseQuality, sort_by: 'popularity.desc', with_keywords: kw2 }), 3)
          });
        } else {
          if (kw1) {
            queryTasks.push({
              tag: hasOrigin ? 'both' : 'p1_kw',
              promise: fetchMultiPageDiscover(withJointFilters({ ...baseQuality, sort_by: 'vote_average.desc', with_keywords: kw1 }), 3)
            });
          }
          if (kw2) {
            queryTasks.push({
              tag: hasOrigin ? 'both' : 'p2_kw',
              promise: fetchMultiPageDiscover(withJointFilters({ ...baseQuality, sort_by: 'vote_average.desc', with_keywords: kw2 }), 3)
            });
          }
        }
        // C) Tür kesişimi (AND = virgül) veya Ülke + Tek Tür kesişimi (örn: Kore + Romantik!)
        if (g1 && g2) {
          const andGenres = Array.from(new Set([g1, g2])).join(',');
          queryTasks.push({
            tag: 'genre_both',
            promise: fetchMultiPageDiscover(withJointFilters({ ...baseQuality, sort_by: 'vote_average.desc', with_genres: andGenres }), 3)
          });
          queryTasks.push({
            tag: 'genre_both',
            promise: fetchMultiPageDiscover(withJointFilters({ ...baseQuality, sort_by: 'popularity.desc', with_genres: andGenres }), 2)
          });
        } else if (hasOrigin && (g1 || g2)) {
          const singleG = String(g1 || g2);
          queryTasks.push({
            tag: 'both',
            promise: fetchMultiPageDiscover(withJointFilters({ ...baseQuality, sort_by: 'vote_average.desc', with_genres: singleG }), 3)
          });
          queryTasks.push({
            tag: 'both',
            promise: fetchMultiPageDiscover(withJointFilters({ ...baseQuality, sort_by: 'popularity.desc', with_genres: singleG }), 2)
          });
        } else if (hasOrigin && !kw1 && !kw2) {
          // Örn: 1. Kişi: Kore, 2. Kişi: Fransız
          queryTasks.push({
            tag: 'both',
            promise: fetchMultiPageDiscover(withJointFilters({ ...baseQuality, sort_by: 'vote_average.desc' }), 3)
          });
          queryTasks.push({
            tag: 'both',
            promise: fetchMultiPageDiscover(withJointFilters({ ...baseQuality, sort_by: 'popularity.desc' }), 2)
          });
        }

        const taskResults = await Promise.all(
          queryTasks.map(t => t.promise.then(res => ({ tag: t.tag, res })).catch(() => ({ tag: t.tag, res: [] })))
        );

        // Adayları birleştir ve her filmin 1. Kişi + 2. Kişi ortak eşleşme skorunu hesapla
        const scoredMap = new Map();
        const p1KwIds = new Set();
        const p2KwIds = new Set();

        for (const { tag, res } of taskResults) {
          for (const m of res) {
            if (tag === 'p1_kw') p1KwIds.add(m.id);
            if (tag === 'p2_kw') p2KwIds.add(m.id);
            if (!scoredMap.has(m.id)) {
              scoredMap.set(m.id, { movie: m, score: 0, directBoth: false });
            }
            const entry = scoredMap.get(m.id);
            if (tag === 'both') {
              entry.score += 10;
              entry.directBoth = true;
            } else if (tag === 'genre_both') {
              entry.score += 5;
            } else {
              entry.score += 3;
            }
          }
        }

        // Eğer hem p1_kw hem p2_kw havuzunda birden çıktıysa -> gerçek çift konu kesişimi!
        for (const [id, entry] of scoredMap.entries()) {
          const m = entry.movie;
          const mGenres = m.genre_ids || [];
          const hitP1 = p1KwIds.has(id) || (p1.genreIds.length && p1.genreIds.some(g => mGenres.includes(g)));
          const hitP2 = p2KwIds.has(id) || (p2.genreIds.length && p2.genreIds.some(g => mGenres.includes(g)));

          if (p1KwIds.has(id) && p2KwIds.has(id)) {
            entry.score += 14;
            entry.directBoth = true;
          } else if (hitP1 && hitP2) {
            entry.score += 6;
          }
          // Puan bonusu
          entry.score += ((m.vote_average || 7) - 6.5) * 1.5;
        }

        // Çok dar kaldıysa gizli hazine üst sınırını kaldırıp bir kez daha genişlet
        if (scoredMap.size < 6 && hiddenGemsOnly && (g1 || g2 || kw1 || kw2)) {
          const fallbackParams = withJointFilters({
            language: 'tr-TR',
            sort_by: 'popularity.desc',
            include_adult: 'false',
            'vote_average.gte': 6.5,
            'vote_count.gte': hasOrigin ? 20 : 40,
            ...(g1 && g2 ? { with_genres: Array.from(new Set([g1, g2])).join(',') } : (g1 || g2 ? { with_genres: String(g1 || g2) } : {})),
            ...(kw1 || kw2 ? { with_keywords: [kw1, kw2].filter(Boolean).join('|') } : {})
          });
          const extra = await fetchMultiPageDiscover(fallbackParams, 2).catch(() => []);
          for (const m of extra) {
            if (!scoredMap.has(m.id)) {
              scoredMap.set(m.id, { movie: m, score: (m.vote_average || 6.5), directBoth: false });
            }
          }
        }

        const ranked = Array.from(scoredMap.values())
          .sort((a, b) => b.score - a.score)
          .map(x => x.movie);

        if (!ranked.length) {
          showStatus(
            platformLabels.length
              ? `Seçili platformlarda (${platformLabels.join(', ')}) "${q1}" ve "${q2}" kesişiminde film bulunamadı. Platform filtresini kaldırıp veya genişletip tekrar deneyebilirsin.`
              : `"${q1}" ve "${q2}" için ortak film bulunamadı. Konulardan birini biraz daha farklı bir kelimeyle yazıp deneyebilirsin.`,
            'error'
          );
          return;
        }

        const watchedIds = getWatchedTmdbIdSet();
        let unseen = ranked.filter(m => !seenJointIds.has(m.id) && !watchedIds.has(m.id));
        if (!unseen.length) {
          seenJointIds.clear();
          unseen = ranked.filter(m => !watchedIds.has(m.id));
        }
        if (!unseen.length) {
          seenJointIds.clear();
          unseen = ranked;
        }

        // En yüksek skorlu ilk 20 ortak aday arasından çeşitlilikle seç
        const topPool = unseen.slice(0, Math.min(unseen.length, 20));
        const picked = topPool[Math.floor(Math.random() * topPool.length)];
        seenJointIds.add(picked.id);

        const fullMovie = await fetchFullMovieByTmdbId(picked.id, activeMediaType);
        renderMovie(fullMovie);

        $('moodBannerTitle').textContent = '2 Kişilik Ortak Seçim:';
        const extraTags = getExtraFilterLabels();
        $('moodBannerText').textContent = ` ${p1.displayLabel} + ${p2.displayLabel}${platformLabels.length ? ` • ${platformLabels.join(', ')}` : ''}${extraTags.length ? ` • ${extraTags.join(', ')}` : ''} (${ranked.length} ortak aday içinden seçildi)`;
        $('moodBanner').classList.remove('hidden');
        hideStatus();
      } catch (err) {
        showStatus(`Ortak film aranırken bir hata oluştu: ${err.message}`, 'error');
      }
    }

