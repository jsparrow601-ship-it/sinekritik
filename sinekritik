    // TMDb API Çağrısı
    async function tmdbFetch(path, params = {}) {
      const key = getTmdbKey();
      if (!key) throw new Error('TMDb API anahtarı bulunamadı.');
      const url = new URL(`https://api.themoviedb.org/3${path}`);
      const headers = { accept: 'application/json' };
      const isBearer = key.length > 40 && key.includes('.');
      if (isBearer) {
        headers.Authorization = `Bearer ${key}`;
      } else {
        url.searchParams.set('api_key', key);
      }
      for (const [k, v] of Object.entries(params)) {
        if (v !== undefined && v !== null && v !== '') url.searchParams.set(k, String(v));
      }
      const res = await fetch(url.toString(), { headers });
      if (!res.ok) throw new Error(`TMDb isteği başarısız oldu (${res.status}).`);
      return res.json();
    }

    // OMDb API Çağrısı (Film ve Dizi destekli)
    async function omdbFetch({ imdbId, title, year, mediaType = 'movie' }) {
      const key = getOmdbKey();
      if (!key) return null;
      const url = new URL('https://www.omdbapi.com/');
      url.searchParams.set('apikey', key);
      url.searchParams.set('tomatoes', 'true');
      if (imdbId) {
        url.searchParams.set('i', imdbId);
      } else if (title) {
        url.searchParams.set('t', title);
        url.searchParams.set('type', mediaType === 'tv' ? 'series' : 'movie');
        if (year) url.searchParams.set('y', String(year));
      } else {
        return null;
      }
      try {
        const res = await fetch(url.toString());
        if (!res.ok) return null;
        const data = await res.json();
        if (data.Response === 'False') return null;
        return data;
      } catch {
        return null;
      }
    }

    function extractOmdbRatings(omdb) {
      if (!omdb) return { imdb: null, imdbVotes: '', rt: null, metascore: null, poster: '', actors: '', director: '' };
      const imdb = omdb.imdbRating && omdb.imdbRating !== 'N/A' ? parseFloat(omdb.imdbRating) : null;
      const imdbVotes = omdb.imdbVotes && omdb.imdbVotes !== 'N/A' ? omdb.imdbVotes : '';
      let rt = null;
      if (Array.isArray(omdb.Ratings)) {
        const rtObj = omdb.Ratings.find(r => r.Source === 'Rotten Tomatoes');
        if (rtObj && rtObj.Value) {
          const parsed = parseInt(rtObj.Value.replace('%', ''), 10);
          if (!Number.isNaN(parsed)) rt = parsed;
        }
      }
      if (rt === null && omdb.tomatoMeter && omdb.tomatoMeter !== 'N/A') {
        const parsed = parseInt(omdb.tomatoMeter, 10);
        if (!Number.isNaN(parsed)) rt = parsed;
      }
      let metascore = null;
      if (omdb.Metascore && omdb.Metascore !== 'N/A') {
        const parsed = parseInt(omdb.Metascore, 10);
        if (!Number.isNaN(parsed)) metascore = parsed;
      }
      const poster = omdb.Poster && omdb.Poster !== 'N/A' ? omdb.Poster : '';
      const actors = omdb.Actors && omdb.Actors !== 'N/A' ? omdb.Actors : '';
      const director = omdb.Director && omdb.Director !== 'N/A' ? omdb.Director : '';
      return { imdb, imdbVotes, rt, metascore, poster, actors, director };
    }

    // Türkiye İzleme Platformlarını Ayıkla
    function extractTrWatchProviders(rawWatchData, fallbackTitle) {
      const tr = rawWatchData?.results?.TR || null;
      const justWatchSearch = `https://www.justwatch.com/tr/ara?q=${encodeURIComponent(fallbackTitle || '')}`;
      if (!tr) {
        return { link: justWatchSearch, flatrate: [], freeAds: [], rentBuy: [], hasAny: false };
      }

      const mapProvider = (p) => ({
        id: p.provider_id,
        name: p.provider_name,
        logo: p.logo_path ? `https://image.tmdb.org/t/p/w92${p.logo_path}` : ''
      });

      const dedupe = (arr) => {
        const seen = new Set();
        return (arr || []).filter(p => {
          if (!p || seen.has(p.provider_id)) return false;
          seen.add(p.provider_id);
          return true;
        }).map(mapProvider);
      };

      const flatrate = dedupe(tr.flatrate);
      const freeAds = dedupe([...(tr.free || []), ...(tr.ads || [])]);

      const rentMap = new Map();
      for (const p of (tr.rent || [])) {
        rentMap.set(p.provider_id, { ...mapProvider(p), rent: true, buy: false });
      }
      for (const p of (tr.buy || [])) {
        if (rentMap.has(p.provider_id)) {
          rentMap.get(p.provider_id).buy = true;
        } else {
          rentMap.set(p.provider_id, { ...mapProvider(p), rent: false, buy: true });
        }
      }
      const rentBuy = Array.from(rentMap.values()).map(item => ({
        ...item,
        actionLabel: item.rent && item.buy ? 'Kirala / Satın Al' : (item.rent ? 'Kirala' : 'Satın Al')
      }));

      const hasAny = flatrate.length > 0 || freeAds.length > 0 || rentBuy.length > 0;
      return {
        link: tr.link || justWatchSearch,
        flatrate,
        freeAds,
        rentBuy,
        hasAny
      };
    }

