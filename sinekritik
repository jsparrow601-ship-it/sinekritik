              surface: '#111827',
              card: '#161f33',
              border: '#25314d',
              gold: '#f5c518',
              tomato: '#fa320a',
              fresh: '#22c55e',
              accent: '#e11d48'
            }
          }
        }
      }
    };
  </script>
  <style>
    body {
      background-color: #0b0f19;
      color: #f1f5f9;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    }
    .hero-glow {
      background:
        radial-gradient(circle at 20% 20%, rgba(225, 29, 72, 0.18), transparent 45%),
        radial-gradient(circle at 80% 10%, rgba(245, 197, 24, 0.14), transparent 40%),
        linear-gradient(180deg, #111827 0%, #0b0f19 100%);
    }
    .scrollbar-thin::-webkit-scrollbar { width: 6px; }
    .scrollbar-thin::-webkit-scrollbar-track { background: #0b0f19; }
    .scrollbar-thin::-webkit-scrollbar-thumb { background: #25314d; border-radius: 9999px; }
  </style>
</head>
<body class="min-h-screen flex flex-col">

  <!-- Üst Menü -->
  <header class="sticky top-0 z-30 backdrop-blur-md bg-cinema-bg/85 border-b border-cinema-border/70">
    <div class="max-w-4xl mx-auto px-4 py-3.5 flex items-center justify-between gap-3">
      <div class="flex items-center gap-2.5 min-w-0">
        <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-rose-600 to-amber-500 flex items-center justify-center text-white font-black text-lg shadow-lg shadow-rose-900/30 shrink-0">
          S
        </div>
        <div class="min-w-0">
          <h1 class="text-lg font-extrabold tracking-tight text-white leading-none truncate">SineKritik</h1>
          <p class="text-[11px] text-slate-400 mt-0.5 truncate">Canlı IMDb &amp; Rotten Tomatoes Eleştirmeni</p>
        </div>
      </div>

      <div class="flex items-center gap-2 shrink-0">
        <button id="openWatchlistBtn" type="button"
          class="px-3 py-1.5 rounded-lg bg-cinema-card border border-cinema-border hover:border-slate-500 text-xs font-medium text-slate-200 flex items-center gap-1.5 transition">
          <span>Listem</span>
          <span id="watchlistCount" class="px-1.5 py-0.5 rounded-md bg-rose-600/25 text-rose-300 text-[11px] font-bold">0</span>
        </button>
        <button id="openSettingsBtn" type="button"
          class="px-3 py-1.5 rounded-lg bg-cinema-card border border-cinema-border hover:border-slate-500 text-xs font-medium text-slate-300 transition">
          Ayarlar
        </button>
      </div>
    </div>
  </header>

  <!-- Ana İçerik -->
  <main class="flex-1">
    <!-- Arama, Ruh Hali & 2 Kişilik Ortak Film Seçimi -->
    <section class="hero-glow border-b border-cinema-border/60">
      <div class="max-w-4xl mx-auto px-4 py-8 sm:py-10 space-y-5">
        <div class="text-center max-w-2xl mx-auto space-y-3">
          <div class="inline-flex rounded-2xl bg-cinema-surface/95 p-1 border border-cinema-border shadow-lg">
            <button id="mediaTypeMovieBtn" type="button"
              class="px-5 py-2 rounded-xl text-xs sm:text-sm font-bold bg-rose-600 text-white shadow transition">
              🎬 Film
            </button>
            <button id="mediaTypeTvBtn" type="button"
              class="px-5 py-2 rounded-xl text-xs sm:text-sm font-bold text-slate-300 hover:text-white transition">
              📺 Dizi
            </button>
          </div>
          <h2 id="heroHeading" class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">
            Bu film izlemeye değer mi?
          </h2>
          <p id="heroSubtext" class="text-sm text-slate-300">
            Film adını yaz, bugünkü ruh halini seç ya da iki kişilik ortak film bul; güncel IMDb, Rotten Tomatoes puanlarını, Türkiye izleme platformlarını ve yüksek puanlı benzer filmleri anında gör.
          </p>
        </div>

        <!-- Film Arama Formu -->
        <form id="searchForm" class="max-w-2xl mx-auto flex flex-col sm:flex-row gap-2.5">
          <input id="movieInput" type="text" autocomplete="off"
            placeholder="Film adı yazın (örn: Parazit, Başlangıç, Past Lives, Kış Uykusu...)"
            class="flex-1 px-4 py-3.5 rounded-xl bg-cinema-surface/95 border border-cinema-border focus:border-rose-500 focus:outline-none text-white placeholder-slate-400 text-sm shadow-inner" />
          <button id="searchBtn" type="submit"
            class="px-6 py-3.5 rounded-xl bg-rose-600 hover:bg-rose-500 active:scale-[0.99] text-white font-semibold text-sm transition shadow-lg shadow-rose-900/30 whitespace-nowrap">
            Eleştiriyi Getir
          </button>
        </form>

        <!-- Ruh Haline Göre / 2 Kişilik Ortak Keşif Kutusu -->
        <div class="max-w-2xl mx-auto rounded-2xl bg-cinema-surface/85 border border-cinema-border/80 p-4 sm:p-5 space-y-4">
          <!-- Mod Seçici Sekmeler -->
          <div class="flex flex-wrap items-center justify-between gap-2.5">
            <div class="inline-flex rounded-xl bg-cinema-bg p-1 border border-cinema-border/80">
              <button id="tabSingleMode" type="button"
                class="px-3 py-1.5 rounded-lg text-xs font-bold bg-amber-500 text-slate-950 transition">
                Bugünkü Ruh Haline Göre
              </button>
              <button id="tabJointMode" type="button"
                class="px-3 py-1.5 rounded-lg text-xs font-bold text-slate-300 hover:text-white transition">
                2 Kişilik Ortak Film Seç
              </button>
            </div>

            <div class="flex flex-wrap items-center gap-x-3.5 gap-y-1.5">
              <label class="inline-flex items-center gap-1.5 text-xs text-slate-300 cursor-pointer select-none">
                <input id="hiddenGemToggle" type="checkbox" checked class="accent-amber-400 rounded" />
                <span>Az bilinen yüksek puanlı</span>
              </label>
              <label class="inline-flex items-center gap-1.5 text-xs text-slate-300 cursor-pointer select-none">
                <input id="shortRuntimeToggle" type="checkbox" class="accent-emerald-400 rounded" />
                <span id="shortRuntimeLabel">≤ 105 dk</span>
              </label>
              <label class="inline-flex items-center gap-1.5 text-xs text-slate-300 cursor-pointer select-none">
                <input id="recentOnlyToggle" type="checkbox" class="accent-sky-400 rounded" />
                <span>2018 sonrası</span>
              </label>
            </div>
          </div>

          <!-- TEK KİŞİLİK RUH HALİ / KONU PANELİ -->
          <div id="singleMoodPanel" class="space-y-3">
            <div class="flex flex-col sm:flex-row gap-2">
              <input id="moodInput" type="text" autocomplete="off"
                placeholder="Ruh hali, konu veya ülke sineması yaz (örn: kore filmleri, fransız, dövüş, zaman yolculuğu, hüzünlü...)"
                class="flex-1 px-3.5 py-2.5 rounded-xl bg-cinema-bg/90 border border-cinema-border focus:border-amber-400 focus:outline-none text-sm text-white placeholder-slate-400" />
              <button id="moodBtn" type="button"
                class="px-4 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-sm transition whitespace-nowrap">
                Ruh Halime Göre Öner
              </button>
            </div>

            <div class="flex flex-wrap gap-1.5">
              <button type="button" data-mood="hüzünlü" class="mood-chip px-2.5 py-1 rounded-lg bg-cinema-card hover:bg-slate-800 border border-cinema-border text-xs text-slate-300 transition">Hüzünlü</button>
              <button type="button" data-mood="romantik" class="mood-chip px-2.5 py-1 rounded-lg bg-cinema-card hover:bg-slate-800 border border-cinema-border text-xs text-slate-300 transition">Romantik</button>
              <button type="button" data-mood="heyecanlı" class="mood-chip px-2.5 py-1 rounded-lg bg-cinema-card hover:bg-slate-800 border border-cinema-border text-xs text-slate-300 transition">Heyecanlı</button>
              <button type="button" data-mood="dövüş" class="mood-chip px-2.5 py-1 rounded-lg bg-cinema-card hover:bg-slate-800 border border-cinema-border text-xs text-slate-300 transition">Dövüş</button>
              <button type="button" data-mood="gerilim" class="mood-chip px-2.5 py-1 rounded-lg bg-cinema-card hover:bg-slate-800 border border-cinema-border text-xs text-slate-300 transition">Gerilim</button>
              <button type="button" data-mood="düşünceli" class="mood-chip px-2.5 py-1 rounded-lg bg-cinema-card hover:bg-slate-800 border border-cinema-border text-xs text-slate-300 transition">Düşünceli</button>
              <button type="button" data-mood="motive" class="mood-chip px-2.5 py-1 rounded-lg bg-cinema-card hover:bg-slate-800 border border-cinema-border text-xs text-slate-300 transition">Motive</button>
              <button type="button" data-mood="yorgun" class="mood-chip px-2.5 py-1 rounded-lg bg-cinema-card hover:bg-slate-800 border border-cinema-border text-xs text-slate-300 transition">Yorgun / Kafa Dağıtmalık</button>
            </div>
          </div>

          <!-- 2 KİŞİLİK ORTAK FİLM SEÇ PANELİ -->
          <div id="jointMoodPanel" class="hidden space-y-3">
            <p class="text-xs text-slate-300">
              Sınırlama olmadan istediğin konuyu, ruh halini veya ülke sinemasını yazabilirsin (örn: <em>kore filmleri</em>, <em>fransız</em>, <em>dövüş</em>, <em>intikam</em>, <em>soygun</em>, <em>uzay</em>, <em>romantik</em>...). İkisini birleştiren geniş havuzdan yüksek puanlı ortak film seçilir.
            </p>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
              <div class="space-y-1">
                <label for="jointInput1" class="text-[11px] font-semibold uppercase tracking-wider text-rose-300">1. Kişi (Ruh hali veya serbest konu)</label>
                <input id="jointInput1" type="text" autocomplete="off"
                  placeholder="örn: dövüş, samuray, soygun, intikam..."
                  class="w-full px-3.5 py-2.5 rounded-xl bg-cinema-bg/90 border border-cinema-border focus:border-rose-400 focus:outline-none text-sm text-white placeholder-slate-400" />
              </div>
              <div class="space-y-1">
                <label for="jointInput2" class="text-[11px] font-semibold uppercase tracking-wider text-sky-300">2. Kişi (Ruh hali veya serbest konu)</label>
                <input id="jointInput2" type="text" autocomplete="off"
                  placeholder="örn: romantik, komedi, uzay, dedektif..."
                  class="w-full px-3.5 py-2.5 rounded-xl bg-cinema-bg/90 border border-cinema-border focus:border-sky-400 focus:outline-none text-sm text-white placeholder-slate-400" />
              </div>
            </div>

            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2.5">
              <div class="flex flex-wrap gap-1.5">
                <button type="button" data-joint1="dövüş" data-joint2="intikam" class="joint-chip px-2.5 py-1 rounded-lg bg-cinema-card hover:bg-slate-800 border border-cinema-border text-[11px] text-slate-300 transition">Dövüş + İntikam</button>
                <button type="button" data-joint1="romantik" data-joint2="bilim kurgu" class="joint-chip px-2.5 py-1 rounded-lg bg-cinema-card hover:bg-slate-800 border border-cinema-border text-[11px] text-slate-300 transition">Romantik + Bilim Kurgu</button>
                <button type="button" data-joint1="komedi" data-joint2="gerilim" class="joint-chip px-2.5 py-1 rounded-lg bg-cinema-card hover:bg-slate-800 border border-cinema-border text-[11px] text-slate-300 transition">Komedi + Gerilim</button>
                <button type="button" data-joint1="hüzünlü" data-joint2="müzik" class="joint-chip px-2.5 py-1 rounded-lg bg-cinema-card hover:bg-slate-800 border border-cinema-border text-[11px] text-slate-300 transition">Hüzünlü + Müzik</button>
                <button type="button" data-joint1="aksiyon" data-joint2="gizem" class="joint-chip px-2.5 py-1 rounded-lg bg-cinema-card hover:bg-slate-800 border border-cinema-border text-[11px] text-slate-300 transition">Aksiyon + Gizem</button>
              </div>
              <button id="jointBtn" type="button"
                class="px-4 py-2.5 rounded-xl bg-gradient-to-r from-rose-600 to-amber-500 hover:from-rose-500 hover:to-amber-400 text-white font-bold text-sm transition whitespace-nowrap shadow-lg shadow-rose-900/25">
                Ortak Film Öner
              </button>
            </div>
          </div>

          <!-- Platforma Göre Filtre (Her İki Modda da Aktif) -->
          <div class="pt-3 border-t border-cinema-border/70 space-y-2">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <span class="text-[11px] font-semibold uppercase tracking-wider text-sky-300">
                Platform Filtresi (Türkiye)
              </span>
              <span id="platformFilterHint" class="text-[11px] text-slate-400">
                İşaretlediklerin arasından önerir (boşsa tümü)
              </span>
            </div>
            <div id="platformCheckboxes" class="flex flex-wrap gap-2"></div>
          </div>
        </div>
      </div>
    </section>

    <!-- Durum / Yükleniyor Mesajı -->
    <section class="max-w-4xl mx-auto px-4 pt-6">
      <div id="statusBox" class="hidden rounded-xl border px-4 py-3 text-sm"></div>
    </section>

    <!-- Film Sonuç Kartı -->
    <section id="resultSection" class="hidden max-w-4xl mx-auto px-4 py-6 space-y-6">

      <!-- Öneri Yenileme Şeridi -->
      <div id="moodBanner" class="hidden flex flex-wrap items-center justify-between gap-3 rounded-xl bg-amber-500/10 border border-amber-500/30 px-4 py-3">
        <div class="text-sm text-amber-200">
          <span id="moodBannerTitle" class="font-semibold">Ruh Hali Önerisi:</span>
          <span id="moodBannerText"></span>
        </div>
        <button id="anotherMoodBtn" type="button"
          class="px-3.5 py-1.5 rounded-lg bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-xs transition whitespace-nowrap">
          Başka Öneri Getir ↻
        </button>
      </div>

      <!-- Ana Film Kartı -->
      <article class="rounded-2xl bg-cinema-surface border border-cinema-border overflow-hidden shadow-2xl shadow-black/40">
        <!-- Arka Plan Görseli + Başlık & Afiş -->
        <div id="movieHeroHeader" class="relative p-5 sm:p-7 border-b border-cinema-border/80 bg-cinema-surface">
          <div id="movieBackdrop" class="hidden absolute inset-0 bg-cover bg-center opacity-20 pointer-events-none"></div>
          <div class="absolute inset-0 bg-gradient-to-t from-cinema-surface via-cinema-surface/85 to-cinema-surface/65 pointer-events-none"></div>

          <div class="relative flex flex-col sm:flex-row gap-5 sm:gap-6 items-start">
            <!-- Film Afişi -->
            <div class="w-36 sm:w-44 shrink-0 mx-auto sm:mx-0">
              <div class="aspect-[2/3] rounded-xl overflow-hidden border border-cinema-border bg-cinema-card shadow-xl shadow-black/50 flex items-center justify-center relative">
                <img id="moviePoster" src="" alt="Film Afişi"
                  class="hidden w-full h-full object-cover max-w-full" />
                <div id="moviePosterFallback" class="flex flex-col items-center justify-center text-center p-4 text-slate-400">
                  <svg class="w-10 h-10 text-slate-600 mb-2" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3.375 19.5h17.25m-17.25 0a1.125 1.125 0 01-1.125-1.125M3.375 19.5h1.5C5.496 19.5 6 18.996 6 18.375m-3.75 0V5.625m0 12.75v-1.5c0-.621.504-1.125 1.125-1.125m18.375 2.625V5.625m0 12.75c0 .621-.504 1.125-1.125 1.125m1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125m0 3.75h-1.5A1.125 1.125 0 0118 18.375M20.625 4.5H3.375m17.25 0c.621 0 1.125.504 1.125 1.125M20.625 4.5h-1.5C18.504 4.5 18 5.004 18 5.625m3.75 0v1.5c0 .621-.504 1.125-1.125 1.125M3.375 4.5c-.621 0-1.125.504-1.125 1.125M3.375 4.5h1.5C5.496 4.5 6 5.004 6 5.625m-3.75 0v1.5c0 .621.504 1.125 1.125 1.125m0 0h1.5m-1.5 0c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125m1.5-3.75C5.496 8.25 6 7.746 6 7.125v-1.5M4.875 8.25C5.496 8.25 6 8.754 6 9.375v1.5m0-5.25v5.25m0-5.25C6 5.004 6.504 4.5 7.125 4.5h9.75c.621 0 1.125.504 1.125 1.125m1.125 2.625h1.5m-1.5 0A1.125 1.125 0 0118 7.125v-1.5m1.125 2.625c-.621 0-1.125.504-1.125 1.125v1.5m2.625-2.625c.621 0 1.125.504 1.125 1.125v1.5c0 .621-.504 1.125-1.125 1.125M18 5.625v5.25M7.125 12h9.75m-9.75 0A1.125 1.125 0 016 10.875M7.125 12C6.504 12 6 12.504 6 13.125m0-2.25C6 11.496 5.496 12 4.875 12M18 10.875c0 .621-.504 1.125-1.125 1.125M18 10.875c0 .621.504 1.125 1.125 1.125m-2.25 0c.621 0 1.125.504 1.125 1.125m-12 5.25v-5.25m0 5.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125m-12 0v-1.5c0-.621-.504-1.125-1.125-1.125M18 18.375v-5.25m0 5.25v-1.5c0-.621.504-1.125 1.125-1.125M18 13.125v1.5c0 .621.504 1.125 1.125 1.125M18 13.125c0-.621.504-1.125 1.125-1.125M6 13.125v1.5c0 .621-.504 1.125-1.125 1.125M6 13.125C6 12.504 5.496 12 4.875 12m-1.5 0h1.5m-1.5 0c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125M19.125 12h1.5m0 0c.621 0 1.125.504 1.125 1.125v1.5c0 .621-.504 1.125-1.125 1.125m-17.25 0h1.5m14.25 0h1.5" />
                  </svg>
                  <span class="text-[11px]">Afiş bulunamadı</span>
                </div>
              </div>
            </div>

            <!-- Başlık, Meta ve Eleştirmen Kararı -->
            <div class="flex-1 w-full space-y-4">
              <div class="flex flex-wrap items-start justify-between gap-3">
                <div class="space-y-1">
                  <div class="flex flex-wrap items-center gap-2">
                    <span id="sourceBadge" class="px-2 py-0.5 rounded-md bg-emerald-500/15 border border-emerald-500/30 text-emerald-300 text-[11px] font-semibold">Canlı Veri</span>
                    <span id="movieYear" class="text-xs text-slate-400 font-medium"></span>
                    <span id="movieRuntime" class="text-xs text-slate-400"></span>
                  </div>
                  <h3 id="movieTitle" class="text-2xl sm:text-3xl font-extrabold text-white leading-tight"></h3>
                  <p id="movieOriginalTitle" class="text-xs text-slate-400 hidden"></p>
                  <div id="movieGenres" class="flex flex-wrap gap-1.5 pt-1"></div>
                </div>

                <!-- 100 Üzerinden Karar Rozeti -->
                <div class="flex items-center gap-3 bg-cinema-card/90 border border-cinema-border rounded-2xl px-4 py-3 shrink-0">
                  <div class="text-center">
                    <div id="verdictScore" class="text-3xl font-black leading-none text-emerald-400">--</div>
                    <div class="text-[10px] uppercase tracking-wider text-slate-400 mt-1">/ 100 Puan</div>
                  </div>
                  <div class="h-10 w-px bg-cinema-border"></div>
