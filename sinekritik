    // PWA Özel PNG İkonu & Tam Ekran Manifest (Tek dosyadan çalışır)
    function initPwaIconAndManifest() {
      try {
        const createIconPng = (size) => {
          const canvas = document.createElement('canvas');
          canvas.width = size;
          canvas.height = size;
          const ctx = canvas.getContext('2d');
          if (!ctx) return '';
          ctx.fillStyle = '#0b0f19';
          ctx.fillRect(0, 0, size, size);

          const pad = Math.round(size * 0.11);
          const box = size - pad * 2;
          const r = Math.round(size * 0.18);
          const grad = ctx.createLinearGradient(pad, pad, size - pad, size - pad);
          grad.addColorStop(0, '#e11d48');
          grad.addColorStop(1, '#f59e0b');
          ctx.fillStyle = grad;
          ctx.beginPath();
          ctx.moveTo(pad + r, pad);
          ctx.lineTo(pad + box - r, pad);
          ctx.quadraticCurveTo(pad + box, pad, pad + box, pad + r);
          ctx.lineTo(pad + box, pad + box - r);
          ctx.quadraticCurveTo(pad + box, pad + box, pad + box - r, pad + box);
          ctx.lineTo(pad + r, pad + box);
          ctx.quadraticCurveTo(pad, pad + box, pad, pad + box - r);
          ctx.lineTo(pad, pad + r);
          ctx.quadraticCurveTo(pad, pad, pad + r, pad);
          ctx.closePath();
          ctx.fill();

          ctx.fillStyle = '#ffffff';
          ctx.font = `900 ${Math.round(size * 0.52)}px -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif`;
          ctx.textAlign = 'center';
          ctx.textBaseline = 'middle';
          ctx.fillText('S', size / 2, size / 2 + Math.round(size * 0.03));
          return canvas.toDataURL('image/png');
        };

        const icon192 = createIconPng(192);
        const icon512 = createIconPng(512);
        if (icon512) {
          $('appleTouchIcon').href = icon512;
        }
        const manifestObj = {
          name: 'SineKritik — Türkçe Film Eleştirmeni',
          short_name: 'SineKritik',
          start_url: '.',
          display: 'standalone',
          background_color: '#0b0f19',
          theme_color: '#0b0f19',
          icons: [
            ...(icon192 ? [{ src: icon192, sizes: '192x192', type: 'image/png' }] : []),
            ...(icon512 ? [{ src: icon512, sizes: '512x512', type: 'image/png' }] : [])
          ]
        };
        const blob = new Blob([JSON.stringify(manifestObj)], { type: 'application/manifest+json' });
        $('pwaManifestLink').href = URL.createObjectURL(blob);
      } catch {}
    }

        // İzleme Listesi
    function updateWatchlistButton() {
      if (!currentMovie) return;
      const list = getWatchlist();
      const exists = list.some(m => m.id === currentMovie.id);
      const btn = $('toggleWatchlistBtn');
      if (exists) {
        btn.textContent = '✓ İzleme Listemde';
        btn.classList.add('border-emerald-500/50', 'text-emerald-300');
      } else {
        btn.textContent = '+ İzleme Listeme Ekle';
        btn.classList.remove('border-emerald-500/50', 'text-emerald-300');
      }
    }

    function renderWatchlistModal() {
      const isWatched = activeListModalTab === 'watched';
      $('modalTabWatchlist').className = `px-3 py-1.5 rounded-lg text-xs font-bold transition ${
        !isWatched ? 'bg-rose-600 text-white' : 'text-slate-300 hover:text-white'
      }`;
      $('modalTabWatched').className = `px-3 py-1.5 rounded-lg text-xs font-bold transition ${
        isWatched ? 'bg-emerald-600 text-white' : 'text-slate-300 hover:text-white'
      }`;

      const body = $('watchlistBody');
      if (!isWatched) {
        const list = getWatchlist();
        if (!list.length) {
          body.innerHTML = '<p class="text-sm text-slate-400 text-center py-6">İzleme listen henüz boş.</p>';
          return;
        }
        body.innerHTML = list.map((item, idx) => `
          <div class="flex items-center justify-between gap-3 rounded-xl bg-cinema-card border border-cinema-border p-3">
            <button type="button" data-wl-open="${idx}" class="text-left flex-1 min-w-0">
              <div class="text-sm font-bold text-white truncate hover:text-rose-300">${escapeHtml(item.title)}</div>
              <div class="text-xs text-slate-400">${escapeHtml(item.year || '')} ${item.imdb ? `• IMDb ${Number(item.imdb).toFixed(1)}` : ''}</div>
            </button>
            <button type="button" data-wl-del="${idx}" class="px-2 py-1 rounded-lg text-xs text-slate-400 hover:bg-rose-500/20 hover:text-rose-300">Sil</button>
          </div>
        `).join('');

        body.querySelectorAll('[data-wl-open]').forEach(btn => {
          btn.addEventListener('click', () => {
            const item = list[Number(btn.dataset.wlOpen)];
            $('watchlistModal').classList.add('hidden');
            if (item.tmdbId) {
              showStatus(`"${item.title}" getiriliyor...`, 'info');
              fetchFullMovieByTmdbId(item.tmdbId, item.mediaType || 'movie').then(full => { renderMovie(full); hideStatus(); });
            } else {
              searchMovie(item.title);
            }
          });
        });

        body.querySelectorAll('[data-wl-del]').forEach(btn => {
          btn.addEventListener('click', () => {
            const next = getWatchlist().filter((_, i) => i !== Number(btn.dataset.wlDel));
            saveWatchlist(next);
            renderWatchlistModal();
            updateWatchlistButton();
          });
        });
      } else {
        const list = getWatchedList();
        if (!list.length) {
          body.innerHTML = '<p class="text-sm text-slate-400 text-center py-6">Henüz izlediğin bir filmi işaretlemedin.</p>';
          return;
        }
        body.innerHTML = list.map((item, idx) => `
          <div class="rounded-xl bg-cinema-card border border-cinema-border p-3 space-y-1.5">
            <div class="flex items-center justify-between gap-2">
              <button type="button" data-watched-open="${idx}" class="text-left flex-1 min-w-0">
                <div class="text-sm font-bold text-white truncate hover:text-emerald-300">${escapeHtml(item.title)}</div>
                <div class="text-xs text-slate-400">${escapeHtml(item.year || '')} • <span class="text-emerald-300 font-semibold">Puanın: ${item.personalScore}/10</span></div>
              </button>
              <button type="button" data-watched-del="${idx}" class="px-2 py-1 rounded-lg text-xs text-slate-400 hover:bg-rose-500/20 hover:text-rose-300 shrink-0">Sil</button>
            </div>
            ${item.note ? `<p class="text-xs text-slate-300 bg-cinema-surface/80 rounded-lg px-2.5 py-1.5 border border-cinema-border/60">"${escapeHtml(item.note)}"</p>` : ''}
          </div>
        `).join('');

        body.querySelectorAll('[data-watched-open]').forEach(btn => {
          btn.addEventListener('click', () => {
            const item = list[Number(btn.dataset.watchedOpen)];
            $('watchlistModal').classList.add('hidden');
            if (item.tmdbId) {
              showStatus(`"${item.title}" getiriliyor...`, 'info');
              fetchFullMovieByTmdbId(item.tmdbId, item.mediaType || 'movie').then(full => { renderMovie(full); hideStatus(); });
            } else {
              searchMovie(item.title);
            }
          });
        });

        body.querySelectorAll('[data-watched-del]').forEach(btn => {
          btn.addEventListener('click', () => {
            const next = getWatchedList().filter((_, i) => i !== Number(btn.dataset.watchedDel));
            saveWatchedList(next);
            renderWatchlistModal();
            updateWatchedButton();
          });
        });
      }
    }

    // Olay Dinleyicileri
    $('searchForm').addEventListener('submit', (e) => {
      e.preventDefault();
      searchMovie($('movieInput').value);
    });

    $('mediaTypeMovieBtn').addEventListener('click', () => switchMediaType('movie'));
    $('mediaTypeTvBtn').addEventListener('click', () => switchMediaType('tv'));

    $('tabSingleMode').addEventListener('click', () => switchDiscoveryTab('single'));
    $('tabJointMode').addEventListener('click', () => switchDiscoveryTab('joint'));

    $('moodBtn').addEventListener('click', () => recommendByMood($('moodInput').value));
    $('moodInput').addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        recommendByMood($('moodInput').value);
      }
    });

    document.querySelectorAll('.mood-chip').forEach(chip => {
      chip.addEventListener('click', () => {
        $('moodInput').value = chip.dataset.mood;
        recommendByMood(chip.dataset.mood);
      });
    });

    $('jointBtn').addEventListener('click', () => recommendJointMovie($('jointInput1').value, $('jointInput2').value));
    ['jointInput1', 'jointInput2'].forEach(id => {
      $(id).addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          recommendJointMovie($('jointInput1').value, $('jointInput2').value);
        }
      });
    });

    document.querySelectorAll('.joint-chip').forEach(chip => {
      chip.addEventListener('click', () => {
        $('jointInput1').value = chip.dataset.joint1;
        $('jointInput2').value = chip.dataset.joint2;
        recommendJointMovie(chip.dataset.joint1, chip.dataset.joint2);
      });
    });

    $('refreshSimilarBtn').addEventListener('click', async () => {
      if (!currentMovie || !Array.isArray(currentMovie.similarPool) || currentMovie.similarPool.length <= 3) return;
      const btn = $('refreshSimilarBtn');
      btn.disabled = true;
      btn.textContent = 'Yükleniyor...';
      try {
        let start = currentMovie.similarOffset || 0;
        if (start >= currentMovie.similarPool.length) start = 0;
        let nextRaw = currentMovie.similarPool.slice(start, start + 3);
        if (nextRaw.length < 3) {
          nextRaw = [...nextRaw, ...currentMovie.similarPool.slice(0, 3 - nextRaw.length)];
          currentMovie.similarOffset = 3 - (currentMovie.similarPool.length - start);
        } else {
          currentMovie.similarOffset = start + 3;
        }
        const hydrated = await hydrateSimilarBatch(nextRaw, currentMovie.mediaType || 'movie');
        currentMovie.similar = hydrated;
        renderSimilarList(hydrated, true);
      } finally {
        btn.disabled = false;
        btn.textContent = 'Farklı 3 Öneri ↻';
      }
    });

        $('anotherMoodBtn').addEventListener('click', () => {
      if (activeRecMode === 'joint') {
        recommendJointMovie(lastJointQueries.p1 || $('jointInput1').value, lastJointQueries.p2 || $('jointInput2').value);
      } else {
        recommendByMood(lastSingleQuery || $('moodInput').value || 'düşünceli');
      }
    });

    document.querySelectorAll('.lens-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        currentLens = btn.dataset.lens;
        updateVerdictUI();
      });
    });

    $('toggleWatchlistBtn').addEventListener('click', () => {
      if (!currentMovie) return;
      const list = getWatchlist();
      const exists = list.some(m => m.id === currentMovie.id);
      if (exists) {
        saveWatchlist(list.filter(m => m.id !== currentMovie.id));
      } else {
        list.unshift({
          id: currentMovie.id,
          tmdbId: currentMovie.tmdbId,
          mediaType: currentMovie.mediaType || 'movie',
          title: currentMovie.title,
          year: currentMovie.year,
          imdb: currentMovie.imdb
        });
        saveWatchlist(list);
      }
      updateWatchlistButton();
    });

    $('openWatchlistBtn').addEventListener('click', () => {
      renderWatchlistModal();
      $('watchlistModal').classList.remove('hidden');
    });

    $('openSettingsBtn').addEventListener('click', () => {
      $('tmdbKeyInput').value = getTmdbKey();
      $('omdbKeyInput').value = getOmdbKey();
      $('testResultBox').classList.add('hidden');
      $('settingsModal').classList.remove('hidden');
    });

    document.querySelectorAll('[data-close-modal]').forEach(btn => {
      btn.addEventListener('click', () => $(btn.dataset.closeModal).classList.add('hidden'));
    });

    $('saveApiBtn').addEventListener('click', () => {
      safeSetStorage('sinekritik_tmdb_key', $('tmdbKeyInput').value.trim());
      safeSetStorage('sinekritik_omdb_key', $('omdbKeyInput').value.trim());
      $('settingsModal').classList.add('hidden');
      showStatus('API ayarları kaydedildi.', 'success');
    });

    $('testApiBtn').addEventListener('click', async () => {
      const box = $('testResultBox');
      box.className = 'rounded-xl border border-cinema-border bg-cinema-bg px-3 py-2.5 text-xs text-slate-300';
      box.textContent = 'TMDb ve OMDb bağlantıları test ediliyor...';
      box.classList.remove('hidden');

      safeSetStorage('sinekritik_tmdb_key', $('tmdbKeyInput').value.trim());
      safeSetStorage('sinekritik_omdb_key', $('omdbKeyInput').value.trim());

      const notes = [];
      try {
        await tmdbFetch('/configuration');
        notes.push('TMDb: Çalışıyor ✓');
      } catch (e) {
        notes.push(`TMDb: Hata (${e.message})`);
      }

      try {
        const omdbTest = await omdbFetch({ imdbId: 'tt1375666' });
        if (omdbTest) {
          const r = extractOmdbRatings(omdbTest);
          notes.push(`OMDb: Çalışıyor ✓ (Inception IMDb ${r.imdb || '-'}, RT %${r.rt || '-'})`);
        } else {
          notes.push('OMDb: Yanıt alınamadı (e-postadaki aktivasyon linkine tıklandığından emin ol).');
        }
      } catch {
        notes.push('OMDb: Bağlantı hatası.');
      }

      box.textContent = notes.join(' | ');
    });

    $('modalTabWatchlist').addEventListener('click', () => {
      activeListModalTab = 'watchlist';
      renderWatchlistModal();
    });

    $('modalTabWatched').addEventListener('click', () => {
      activeListModalTab = 'watched';
      renderWatchlistModal();
    });

    $('toggleWatchedBtn').addEventListener('click', openWatchedModalForCurrent);

    $('saveWatchedBtn').addEventListener('click', () => {
      if (!currentMovie) return;
      const list = getWatchedList().filter(m => m.id !== currentMovie.id);
      list.unshift({
        id: currentMovie.id,
        tmdbId: currentMovie.tmdbId,
        mediaType: currentMovie.mediaType || 'movie',
        title: currentMovie.title,
        year: currentMovie.year,
        personalScore: pendingPersonalScore,
        note: $('personalNoteInput').value.trim(),
        watchedAt: new Date().toISOString().slice(0, 10)
      });
      saveWatchedList(list);
      // İzlediyse izleme listesinden otomatik düşür
      saveWatchlist(getWatchlist().filter(m => m.id !== currentMovie.id));
      $('watchedRateModal').classList.add('hidden');
      updateWatchedButton();
      updateWatchlistButton();
      showStatus(`"${currentMovie.title}" izlediklerin listesine (${pendingPersonalScore}/10) kaydedildi.`, 'success');
    });

    $('removeWatchedBtn').addEventListener('click', () => {
      if (!currentMovie) return;
      saveWatchedList(getWatchedList().filter(m => m.id !== currentMovie.id));
      $('watchedRateModal').classList.add('hidden');
      updateWatchedButton();
    });

    $('copySummaryBtn').addEventListener('click', async () => {
      if (!currentMovie) return;
      const text = buildShareMessage(currentMovie);
      const btn = $('copySummaryBtn');
      let copied = false;
      try {
        if (navigator.clipboard && navigator.clipboard.writeText) {
          await navigator.clipboard.writeText(text);
          copied = true;
        }
      } catch {}
      if (!copied) {
        try {
          const ta = document.createElement('textarea');
          ta.value = text;
          ta.style.position = 'fixed';
          ta.style.opacity = '0';
          document.body.appendChild(ta);
          ta.select();
          document.execCommand('copy');
          document.body.removeChild(ta);
          copied = true;
        } catch {}
      }
      if (copied) {
        btn.textContent = '✓ Kopyalandı';
        setTimeout(() => { btn.textContent = 'Özeti Kopyala'; }, 2000);
      }
    });

    // Başlangıç
    updateWatchlistBadge();
    renderPlatformCheckboxes();
    updatePlatformHint();
    syncTrPlatformIds();
    initPwaIconAndManifest();
  </script>
</body>
</html>
