    async function openPersonFilmography(personId, personName, roleLabel) {
      $('personModalName').textContent = personName;
      $('personModalRole').textContent = `${roleLabel} • En yüksek puanlı filmleri`;
      $('personModalBody').innerHTML = '<p class="text-sm text-slate-400 text-center py-6">Filmografi yükleniyor...</p>';
      $('personModal').classList.remove('hidden');

      try {
        const credits = await tmdbFetch(`/person/${personId}/combined_credits`, { language: 'tr-TR' });
        let rawList = [];
        if (roleLabel === 'Yönetmen') {
          rawList = (credits.crew || []).filter(c => c.job === 'Director' || c.job === 'Creator' || c.job === 'Executive Producer');
        } else {
          rawList = credits.cast || [];
        }
        rawList = rawList.filter(c => c.media_type === 'movie' || c.media_type === 'tv');
        if (!rawList.length) {
          rawList = [...(credits.cast || []), ...(credits.crew || [])];
        }

        const seen = new Set();
        const filtered = rawList
          .filter(m => {
            if (!m || !m.id || seen.has(m.id)) return false;
            if (currentMovie && m.id === currentMovie.tmdbId) return false;
            seen.add(m.id);
            return (m.vote_count || 0) >= 40 && (m.vote_average || 0) >= 6.0;
          })
          .sort((a, b) => ((b.vote_average || 0) * 10 + Math.log10((b.vote_count || 1) + 1) * 3) - ((a.vote_average || 0) * 10 + Math.log10((a.vote_count || 1) + 1) * 3))
          .slice(0, 12);

        if (!filtered.length) {
          $('personModalBody').innerHTML = '<p class="text-sm text-slate-400 text-center py-6">Bu kişi için listelenecek başka yüksek puanlı film bulunamadı.</p>';
          return;
        }

        const items = await Promise.all(filtered.map(async (m) => {
          const isTvItem = m.media_type === 'tv';
          let title = isTvItem ? (m.name || m.original_name) : (m.title || m.original_title);
          const orig = isTvItem ? (m.original_name || m.name) : (m.original_title || m.title);
          if (hasNonLatinScript(title)) {
            title = await resolveTurkishTitle({
              trTitle: title,
              enTitle: '',
              originalTitle: orig,
              originalLang: m.original_language
            });
          }
          return {
            id: m.id,
            mediaType: isTvItem ? 'tv' : 'movie',
            title,
            year: (isTvItem ? (m.first_air_date || '') : (m.release_date || '')).slice(0, 4),
            rating: m.vote_average ? Number(m.vote_average).toFixed(1) : '',
            poster: m.poster_path ? `https://image.tmdb.org/t/p/w154${m.poster_path}` : ''
          };
        }));

        $('personModalBody').innerHTML = items.map(item => `
          <button type="button" data-person-movie="${item.id}" data-person-type="${item.mediaType}" data-person-title="${escapeHtml(item.title)}"
            class="w-full text-left flex items-center gap-3 rounded-xl bg-cinema-card hover:bg-slate-800 border border-cinema-border hover:border-rose-500/50 p-2.5 transition">
            <div class="w-10 aspect-[2/3] rounded-lg overflow-hidden bg-cinema-surface border border-cinema-border shrink-0 flex items-center justify-center">
              ${item.poster ? `<img src="${item.poster}" alt="${escapeHtml(item.title)}" class="w-full h-full object-cover" />` : '<span class="text-xs text-slate-600">🎬</span>'}
            </div>
            <div class="flex-1 min-w-0">
              <div class="text-sm font-bold text-white truncate">${escapeHtml(item.title)}</div>
              <div class="text-xs text-slate-400">${item.mediaType === 'tv' ? 'Dizi' : 'Film'} • ${escapeHtml(item.year || '—')} ${item.rating ? `• ★ ${item.rating}` : ''}</div>
            </div>
            <span class="text-xs text-rose-300 font-semibold shrink-0">Aç →</span>
          </button>
        `).join('');

        $('personModalBody').querySelectorAll('[data-person-movie]').forEach(btn => {
          btn.addEventListener('click', () => {
            const mId = Number(btn.dataset.personMovie);
            const mType = btn.dataset.personType || 'movie';
            const mTitle = btn.dataset.personTitle;
            $('personModal').classList.add('hidden');
            $('moodBanner').classList.add('hidden');
            showStatus(`"${mTitle}" getiriliyor...`, 'info');
            fetchFullMovieByTmdbId(mId, mType).then(full => {
              renderMovie(full);
              hideStatus();
              window.scrollTo({ top: 0, behavior: 'smooth' });
            }).catch(() => searchMovie(mTitle));
          });
        });
      } catch (err) {
        $('personModalBody').innerHTML = `<p class="text-sm text-rose-300 text-center py-6">Filmografi alınamadı: ${escapeHtml(err.message)}</p>`;
      }
    }

