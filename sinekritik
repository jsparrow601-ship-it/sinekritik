      try {
        const snippet = text.trim().slice(0, 480);
        const lang = (sourceLang && sourceLang !== 'tr') ? sourceLang : 'en';
        const res = await fetch(`https://api.mymemory.translated.net/get?q=${encodeURIComponent(snippet)}&langpair=${encodeURIComponent(lang)}|tr`);
        if (!res.ok) return '';
        const data = await res.json();
        const translated = (data?.responseData?.translatedText || '').trim();
        if (translated && !translated.toUpperCase().includes('MYMEMORY WARNING')) return translated;
      } catch {}
      return '';
    }

    // Latin alfabesi dışındaki (Japonca, Hintçe, Arapça, Korece vb.) film isimlerini Türkçeye çevir
    async function resolveTurkishTitle({ trTitle, enTitle, originalTitle, originalLang }) {
      const cleanTr = (trTitle || '').trim();
      const cleanEn = (enTitle || '').trim();
      const cleanOrig = (originalTitle || '').trim();

      // Zaten temiz Latin alfabesinde Türkçe ad varsa doğrudan kullan
      if (cleanTr && !hasNonLatinScript(cleanTr)) {
        return cleanTr;
      }

      const cacheKey = `${cleanTr}|${cleanEn}|${cleanOrig}`;
      if (titleTrCache.has(cacheKey)) return titleTrCache.get(cacheKey);

      let resolved = '';
      // 1) Öncelik: İngilizce/uluslararası ad varsa onu Türkçeye çevir (daha isabetli çeviri verir)
      if (cleanEn && !hasNonLatinScript(cleanEn)) {
        const translatedEn = await translateToTurkish(cleanEn, 'en');
        if (translatedEn && !hasNonLatinScript(translatedEn)) {
          resolved = translatedEn;
        } else {
          resolved = cleanEn;
        }
      }

      // 2) İngilizce ad yoksa orijinal dilden doğrudan Türkçeye çevir (ja|tr, hi|tr, ar|tr vb.)
      if (!resolved && (cleanTr || cleanOrig)) {
        const srcText = cleanTr || cleanOrig;
        const srcLang = (originalLang && originalLang.length === 2 && originalLang !== 'tr') ? originalLang : 'auto';
        const translatedOrig = await translateToTurkish(srcText, srcLang === 'auto' ? 'en' : srcLang);
        if (translatedOrig && !hasNonLatinScript(translatedOrig)) {
          resolved = translatedOrig;
        }
      }

      const finalTitle = resolved || cleanEn || cleanTr || cleanOrig || 'İsimsiz Film';
      titleTrCache.set(cacheKey, finalTitle);
      return finalTitle;
    }

    async function translateToEnglish(text) {
      const clean = (text || '').trim();
      if (!clean) return '';
      try {
        const res = await fetch(`https://api.mymemory.translated.net/get?q=${encodeURIComponent(clean.slice(0, 120))}&langpair=tr|en`);
        if (!res.ok) return clean;
        const data = await res.json();
        const translated = (data?.responseData?.translatedText || '').trim();
        if (translated && !translated.toUpperCase().includes('MYMEMORY WARNING')) {
          return translated.replace(/[.!?]+$/g, '').trim();
        }
      } catch {}
      return clean;
    }

    // TMDb Anahtar Kelime ID'lerini Bul (Önbellekli, Birden Fazla Eşleşme Destekli)
    async function fetchTmdbKeywordIds(englishTerm) {
      const key = (englishTerm || '').trim().toLowerCase();
      if (!key) return [];
      if (keywordCache.has(key)) return keywordCache.get(key);
      try {
        const res = await tmdbFetch('/search/keyword', { query: key });
        const ids = (res?.results || []).slice(0, 4).map(r => String(r.id));
        keywordCache.set(key, ids);
        return ids;
      } catch {
        return [];
      }
    }

    // Serbest Konu, Ülke Sineması veya Ruh Halini Sınırsız Şekilde Çözümle
    async function resolveFreeTopic(rawText) {
      const clean = (rawText || '').trim();
      const lower = clean.toLowerCase();
      const genreSet = new Set();
      const englishTerms = [];
      const countries = [];
      const languages = [];
      let remainder = lower;
      let matchedCountry = false;
      let matchedSpecificTopic = false;

      // 0) Ülke / Sinema / Dil filtresi yakala (örn: "kore filmleri", "fransız dram", "japon")
      for (const entry of COUNTRY_LANGUAGE_MAP) {
        const hitKey = entry.keys.find(k => matchesWholeOrPrefix(remainder, k));
        if (hitKey) {
          matchedCountry = true;
          if (entry.country) countries.push(...entry.country.split('|'));
          if (entry.lang) languages.push(entry.lang);
          const escaped = hitKey.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
          remainder = remainder.replace(new RegExp(`(^|[\\s,.;:/+-])${escaped}[a-zçğıöşü]*`, 'gi'), ' ').trim();
        }
      }

      // "filmleri", "filmi", "sineması", "tarzı" gibi dolgu kelimeleri temizle
      remainder = remainder.replace(/\b(filmleri|filmler|filmi|film|sineması|sinemasi|sinema|tarzı|tarzi|olan|tür|türü|turu)\b/gi, ' ').replace(/\s+/g, ' ').trim();

      // 1) Özgül konu sözlüğünden eşleşenleri al (örn: dövüş -> martial arts, fighting)
      const searchTarget = remainder || lower;
      if (remainder || !matchedCountry) {
        for (const entry of SPECIFIC_TOPIC_KEYWORDS) {
          if (entry.keys.some(k => matchesWholeOrPrefix(searchTarget, k))) {
            matchedSpecificTopic = true;
            entry.kw.forEach(term => englishTerms.push(term));
            entry.genres.forEach(g => genreSet.add(g));
          }
        }
      }

      // 2) Genel ruh hali / tür eşleşmelerini al
      let matchedMoodGenre = false;
      if (remainder || !matchedCountry) {
        for (const entry of MOOD_GENRE_MAP) {
          if (entry.keys.some(k => matchesWholeOrPrefix(searchTarget, k))) {
            matchedMoodGenre = true;
            entry.genreIds.forEach(g => genreSet.add(g));
          }
        }
      }

      // 3) Kalan serbest Türkçe konu kelimesi varsa (ülke adı hariç) İngilizceye çevirip TMDb'de ara!
      if (!matchedSpecificTopic && !matchedMoodGenre && remainder.length >= 2) {
        const translated = await translateToEnglish(remainder);
        if (translated) englishTerms.push(translated);
        englishTerms.push(remainder);
      } else if (!matchedSpecificTopic && !matchedCountry && remainder.split(/\s+/).length >= 2) {
        const translated = await translateToEnglish(remainder);
        if (translated) englishTerms.push(translated);
      }

      // 4) Tüm İngilizce terimler için TMDb anahtar kelime ID'lerini paralel çek
      const uniqueTerms = Array.from(new Set(englishTerms)).slice(0, 3);
      const kwIdArrays = await Promise.all(uniqueTerms.map(t => fetchTmdbKeywordIds(t)));
      const keywordIds = Array.from(new Set(kwIdArrays.flat())).slice(0, 6);

      return {
        raw: clean,
        displayLabel: clean.charAt(0).toUpperCase() + clean.slice(1),
        genreIds: Array.from(genreSet),
        keywordIds,
        countries: Array.from(new Set(countries)),
        languages: Array.from(new Set(languages)),
        englishTerms: uniqueTerms
      };
    }

    function applyOriginParams(params, countries = [], languages = []) {
      if (countries.length) {
        params.with_origin_country = Array.from(new Set(countries)).join('|');
      } else if (languages.length === 1) {
        params.with_original_language = languages[0];
      }
      return params;
    }

    // Çok Sayfalı TMDb Keşif Havuzu (Film ve Dizi destekli)
    async function fetchMultiPageDiscover(baseParams, maxPagesToFetch = 3, mediaType = activeMediaType) {
      const endpoint = mediaType === 'tv' ? '/discover/tv' : '/discover/movie';
      const firstRes = await tmdbFetch(endpoint, { ...baseParams, page: 1 });
      const results = [...(firstRes.results || [])];
      const totalPages = Math.min(firstRes.total_pages || 1, 15);

      if (totalPages > 1 && maxPagesToFetch > 1) {
        const extraPages = new Set();
        while (extraPages.size < Math.min(maxPagesToFetch - 1, totalPages - 1)) {
          extraPages.add(Math.floor(Math.random() * (totalPages - 1)) + 2);
        }
        const extraResponses = await Promise.all(
          Array.from(extraPages).map(pg => tmdbFetch(endpoint, { ...baseParams, page: pg }).catch(() => ({ results: [] })))
        );
        for (const r of extraResponses) {
          results.push(...(r.results || []));
        }
      }
      return results;
    }

    // Seçili platform, süre ve dönem parametrelerini discover sorgusuna ekle (Film + Dizi)
    function applyPlatformParams(params, mediaType = activeMediaType) {
      const providerIds = getSelectedPlatformIds();
